# Copy this file to .env and fill in real values. Never commit .env itself.

# ── LLM provider ────────────────────────────────────────────────────────────
# "ollama" (default, fully local — recommended since real email content is
# processed) or "claude" (cloud, opt-in).
LLM_PROVIDER=ollama

# Ollama settings (used when LLM_PROVIDER=ollama)
# qwen2.5:14b is thorough but genuinely large to run without a capable
# GPU — each analysis is one LLM call now (see combined_analysis.py), but
# that call can still take 30-90s+ on CPU-only hardware. If analysis feels
# slow, run `ollama ps` / check GPU utilization during a request first —
# a model falling back to CPU is the most common cause. If it's already
# using the GPU and still too slow for your hardware, swap in a smaller
# or quantized model as an explicit speed-for-thoroughness tradeoff, e.g.:
#   ollama pull qwen2.5:7b
#   OLLAMA_MODEL=qwen2.5:7b
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_URL=http://localhost:11434

# Claude (used when LLM_PROVIDER=claude)
#ANTHROPIC_API_KEY=sk-ant-...

# ── Threat intel (free-tier APIs) ───────────────────────────────────────────
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=

# ── API auth ─────────────────────────────────────────────────────────────
# Shared secret required in the "X-API-Key" header on /analyze, /threat-check,
# /sandbox. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
